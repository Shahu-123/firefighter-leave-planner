        "text": "={{(() => {\n  const items = $('Compare Calendars').all(); // Get all items\n  return items.map(item => {\n    const { date, slot, platoon, name } = item.json;\n    if (!name || name.trim() === \"\") {\n      return `✅ The ${slot} slot in ${platoon} on ${date} has been cleared.`;\n    } else {\n      return `✅ Calendar updated: ${name} has been added to the ${slot} slot in ${platoon} on ${date}.`;\n    }\n  }).join('\\n'); // Combine all messages with line breaks\n})()}}",
