      "parameters": {
        "jsCode": "function normalizeDate(inputDate) {\n  // Clean spacing and standardize separators\n  const cleaned = inputDate.trim().replace(/[\\.\\s]+/g, '-').replace(/\\//g, '-');\n\n  // Try direct parsing first\n  let parsed = new Date(cleaned);\n  if (!isNaN(parsed)) {\n    const day = parsed.getDate();\n    const monthShort = parsed.toLocaleString('default', { month: 'short' });\n    const yearShort = parsed.getFullYear().toString().slice(-2);\n    return `${day}-${monthShort}-${yearShort}`;\n  }\n\n  // Try fallback regex DD-MM-YY or DD-MM-YYYY\n  const match = cleaned.match(/^(\\d{1,2})-(\\d{1,2})-(\\d{2,4})$/);\n  if (match) {\n    let [ , dd, mm, yyyy ] = match;\n    dd = parseInt(dd, 10);\n    mm = parseInt(mm, 10) - 1;\n    yyyy = parseInt(yyyy, 10);\n    if (yyyy < 100) yyyy += 2000;\n\n    const fallbackDate = new Date(yyyy, mm, dd);\n    if (!isNaN(fallbackDate)) {\n      const day = fallbackDate.getDate();\n      const monthShort = fallbackDate.toLocaleString('default', { month: 'short' });\n      const yearShort = fallbackDate.getFullYear().toString().slice(-2);\n      return `${day}-${monthShort}-${yearShort}`;\n    }\n  }\n\n  throw new Error(`Unrecognized date format: \"${inputDate}\"`);\n}\n\n// Apply to input items\nconst items = $('Receive Calendar Updates').all();\n\nreturn items.map(item => {\n  const { date, slot, platoon, name } = item.json;\n  const cleanDate = normalizeDate(date);\n\n  return {\n    json: {\n      date: cleanDate,\n      slot,\n      platoon,\n      name\n    }\n  };\n});"
      },
