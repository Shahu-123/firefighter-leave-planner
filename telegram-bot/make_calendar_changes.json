        "jsCode": "const inputItems = $('If contains updates').all();\n\nconst resultMap = new Map();\n\nfor (const item of inputItems) {\n  const { date, slot, platoon, name } = item.json;\n  const key = date.trim();\n\n  if (!resultMap.has(key)) {\n    resultMap.set(key, { Date: key });\n  }\n\n  const row = resultMap.get(key);\n  row[`${platoon} ${slot}`] = name || \"\";\n}\n\nconst results = Array.from(resultMap.values()).map(row => ({ json: row }));\nreturn results;"
      },
