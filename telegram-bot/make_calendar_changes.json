      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nconst slots = [\"L1\", \"L2\", \"L3\", \"KIV\"];\nconst platoons = [\"P1\", \"P2\"];\n\nfor (const item of items) {\n  const row = item.json;\n  const date = row[\"Date\"];\n\n  for (const slot of slots) {\n    for (const platoon of platoons) {\n      const key = `${platoon} ${slot}`;\n      const name = row[key]?.trim() || \"\";\n\n      results.push({\n        json: {\n          date,\n          slot,\n          platoon,\n          name\n        }\n      });\n    }\n  }\n}\n\nreturn results;"
      },
