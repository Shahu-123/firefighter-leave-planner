    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const row = item.json;\n  const updatedRow = { ...row };\n  const platoons = ['P1', 'P2'];\n  const slots = ['L1', 'L2', 'L3', 'KIV'];\n\n  for (const platoon of platoons) {\n    for (let i = 0; i < slots.length - 1; i++) {\n      const currentKey = `${platoon} ${slots[i]}`;\n      const nextKey = `${platoon} ${slots[i + 1]}`;\n      const currentVal = (row[currentKey] || \"\").trim().toLowerCase();\n      const nextVal = (row[nextKey] || \"\").trim();\n\n      if ((currentVal === \"\" || currentVal === \"n/a\" || currentVal === \"-\") && nextVal !== \"\") {\n        updatedRow[currentKey] = nextVal;\n        updatedRow[nextKey] = \"\";\n      }\n    }\n  }\n\n  return { json: updatedRow };\n});"
      },
